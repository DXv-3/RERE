# Optional: build against a different sign-in provider or relay.
# `.env.defaults` already builds every copy with CodeWrench account sign-in; values here
# (`cp .env.example .env`) override it. These are public identifiers (every client is a
# public OpenID Connect client), not secrets. Set T3CODE_CLOUD=off to build without sign-in.
# Do not add server-side secrets to this file.

# OpenID Connect issuer (a Keycloak realm). `codewrench-app` is the client for web,
# desktop and mobile; `codewrench-cli` is the client for the server and CLI.
T3CODE_OIDC_ISSUER=https://codewrench-login.savagesolutions.io/realms/codewrench
T3CODE_OIDC_CLIENT_ID=codewrench-app
T3CODE_OIDC_CLI_CLIENT_ID=codewrench-cli

# Relay. For a self-hosted relay, `infra/relay` deploys update it automatically.
T3CODE_RELAY_URL=https://relay.savagesolutions.io

# Optional: signed macOS builds.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
