# Built into every copy of CodeWrench unless `.env`, `.env.local` or the environment says otherwise.
# These are public identifiers (every client is a public OpenID Connect client), not secrets.
# Do not add secrets to this file. Set T3CODE_CLOUD=off to build without account sign-in.
T3CODE_OIDC_ISSUER=https://codewrench-login.savagesolutions.io/realms/codewrench
T3CODE_OIDC_CLIENT_ID=codewrench-app
T3CODE_OIDC_CLI_CLIENT_ID=codewrench-cli
T3CODE_RELAY_URL=https://relay.savagesolutions.io
