# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
# Both must be zones in the account, not subdomains. They may be the same zone:
# endpoints are then <stage>-<hash>.<zone>, which the zone's universal
# certificate covers.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=example.com

# Required: Relay database
# A Postgres you run, reached by Hyperdrive through a Cloudflare Tunnel hostname
# that an Access application restricts to one service token. The database must
# accept TLS. Use a role limited to reading and writing data here; apply
# migrations separately as the owner (see README).
RELAY_DB_HOST=relay-db.example.com
RELAY_DB_NAME=relay
RELAY_DB_USER=relay_runtime
RELAY_DB_PASSWORD=...
RELAY_DB_ACCESS_CLIENT_ID=....access
RELAY_DB_ACCESS_CLIENT_SECRET=...

# Optional: Axiom tracing. With neither AXIOM_TOKEN nor AXIOM_API_KEY set, the
# relay deploys without tracing.
# AXIOM_TOKEN=...
# AXIOM_ORG_ID=...

# Optional: email the person a model is shared with, over SMTP with implicit TLS.
# Off unless ALL FIVE are set. The port must be 465. The wording (owner-approved)
# lives in src/modelShares/modelShareInviteEmail.ts.
# MODEL_SHARE_SMTP_HOST=mail.example.com
# MODEL_SHARE_SMTP_PORT=465
# MODEL_SHARE_SMTP_USER=support@example.com
# MODEL_SHARE_SMTP_PASSWORD=...
# MODEL_SHARE_EMAIL_FROM=CodeWrench <support@example.com>

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required: OpenID Connect
# The relay verifies account access tokens (JWTs) from this issuer and requires
# OIDC_AUDIENCE in the token's `aud` claim. No secret is involved.
OIDC_ISSUER=https://codewrench-login.savagesolutions.io/realms/codewrench
OIDC_AUDIENCE=codewrench-relay

# Apple Push Notification service (required unless APNS_ENABLED=false)
# Set APNS_ENABLED=false for an Android-only development relay.
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}
